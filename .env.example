# SAN CHECKOUT v2 — .env.example
# Copie para ".env" (sem o ".example") e preencha. Nunca commite o .env.

# Asaas
ASAAS_API_KEY=
ASAAS_AMBIENTE=sandbox

# Token de acesso do webhook — configure o MESMO valor no painel da
# Asaas (Integrações → Webhooks → "Token de acesso"). Sem isso, o
# endpoint /api/webhooks/asaas recusa toda chamada com 503 (ninguém
# além da Asaas consegue confirmar pagamento).
ASAAS_WEBHOOK_TOKEN=

# Servidor
PORT=3001
ORIGEM_FRONTEND=http://127.0.0.1:5501

# Supabase — projeto próprio do San Checkout
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Taxa própria do San Checkout — percentual + fixo, somados por cima
# do valor do pedido (nunca descontados do contratante). Valores
# ilustrativos, ajuste antes de qualquer cobrança de verdade.
TAXA_PERCENTUAL=0.9
TAXA_FIXA=0.50

# Login da tela de admin (public/admin.html) — cadastra contratante
# novo sem abrir o Supabase na mão. Só você tem esse usuário/senha;
# escolha uma senha forte e NUNCA reuse um api_key de contratante
# aqui. Sem essas duas variáveis, a tela de admin fica desativada (o
# backend recusa toda chamada com 503).
CHECKOUT_ADMIN_USER=
CHECKOUT_ADMIN_PASS_HASH=
# Gere com: node scripts/gerar-hash-admin.js  (nunca guarde a senha em texto puro)

# --- Opcionais (nenhuma precisa existir; o padrão é o seguro) ---------
# Webhook da Asaas: a origem é conferida contra os IPs OFICIAIS dela
# (webhookController, SEC-007). Por padrão só REGISTRA quem não bate;
# com 1, recusa. Ligar depois de ver o IP da primeira entrega real
# batendo com a lista (docs/pendencias.md, "Modo estrito do IP").
# ASAAS_WEBHOOK_IP_ESTRITO=1
# Lista própria de IPs, separados por vírgula — só se a Asaas publicar
# outros. Sem ela, vale a lista oficial que está no código.
# ASAAS_WEBHOOK_IPS=
#
# NÃO existe variável para desligar o Cloudflare Access do admin, de
# propósito (SEC-015): o `aud` e a equipe são constantes no código, e a
# `CF_ACCESS_CERTS_URL` que as suítes usam só aceita o loopback.
