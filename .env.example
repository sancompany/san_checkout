# SAN CHECKOUT v2 — .env.example
# Copie para ".env" (sem o ".example") e preencha. Nunca commite o .env.

# Asaas
ASAAS_API_KEY=
ASAAS_AMBIENTE=sandbox

# Token de acesso do webhook — configure o MESMO valor no painel da
# Asaas (Integrações → Webhooks → "Token de acesso"). Sem isso, o
# endpoint /api/webhooks/asaas recusa toda chamada com 503 (ninguém
# além da Asaas consegue confirmar pagamento).
ASAAS_WEBHOOK_TOKEN=

# Servidor
PORT=3001
ORIGEM_FRONTEND=http://127.0.0.1:5501

# Supabase — projeto próprio do San Checkout
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Taxa própria do San Checkout — percentual + fixo, somados por cima
# do valor do pedido (nunca descontados do contratante). Valores
# ilustrativos, ajuste antes de qualquer cobrança de verdade.
TAXA_PERCENTUAL=0.9
TAXA_FIXA=0.50

# Login da tela de admin (public/admin.html) — cadastra contratante
# novo sem abrir o Supabase na mão. Só você tem esse usuário/senha;
# escolha uma senha forte e NUNCA reuse um api_key de contratante
# aqui. Sem essas duas variáveis, a tela de admin fica desativada (o
# backend recusa toda chamada com 503).
CHECKOUT_ADMIN_USER=
CHECKOUT_ADMIN_PASS=
