# SAN CHECKOUT v2 — .env.example
# Copie para ".env" (sem o ".example") e preencha. Nunca commite o .env.

# Asaas
ASAAS_API_KEY=
ASAAS_AMBIENTE=sandbox

# Token de acesso do webhook — configure o MESMO valor no painel da
# Asaas (Integrações → Webhooks → "Token de acesso"). Sem isso, o
# endpoint /api/webhooks/asaas recusa toda chamada com 503 (ninguém
# além da Asaas consegue confirmar pagamento).
ASAAS_WEBHOOK_TOKEN=

# Servidor
PORT=3001
ORIGEM_FRONTEND=http://127.0.0.1:5501

# Supabase — projeto próprio do San Checkout
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Taxa própria do San Checkout — percentual + fixo, somados por cima
# do valor do pedido (nunca descontados do contratante). Valores
# ilustrativos, ajuste antes de qualquer cobrança de verdade.
TAXA_PERCENTUAL=0.9
TAXA_FIXA=0.50

# Google Drive — arquivamento de nota fiscal (VISAO_COMPLETA.md seção 8)
# ⚠️ NADA DISSO ESTÁ CONFIGURADO AINDA. Passos manuais necessários
# ANTES de preencher (não é código, é configuração no Google):
#   1. Criar uma service account no Google Cloud Console, gerar a
#      chave JSON.
#   2. Criar um DRIVE COMPARTILHADO (não uma pasta normal do Drive
#      pessoal) no Workspace — service account não tem armazenamento
#      próprio, e pasta normal pode falhar por cota. Drive
#      Compartilhado é o único jeito confiável de automação escrever
#      arquivo.
#   3. Adicionar o e-mail da service account como membro do Drive
#      Compartilhado (permissão de Colaborador ou superior).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Google Drive — arquivamento de nota fiscal (uma pasta por
# contratante, criada automaticamente na primeira nota). Precisa de
# uma conta de serviço (service account) do Google Cloud com a Drive
# API habilitada, e a pasta raiz precisa estar COMPARTILHADA com o
# e-mail dessa conta de serviço (senão ela não enxerga nem escreve nela).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Login da tela de admin (public/admin.html) — cadastra contratante
# novo sem abrir o Supabase na mão. Só você tem esse usuário/senha;
# escolha uma senha forte e NUNCA reuse um api_key de contratante
# aqui. Sem essas duas variáveis, a tela de admin fica desativada (o
# backend recusa toda chamada com 503).
CHECKOUT_ADMIN_USER=
CHECKOUT_ADMIN_PASS=

# E-mail de confirmação de pagamento (SMTP do Google Workspace) —
# disparado pelo webhookController quando uma cobrança confirma.
# ⚠️ Use uma SENHA DE APP do Workspace, não a senha normal da conta —
# o Google bloqueia login SMTP de terceiros com a senha normal mesmo
# com a senha certa. Gerar em: myaccount.google.com/apppasswords
# (exige verificação em duas etapas ativada na conta).
# Sem essas variáveis preenchidas, o e-mail simplesmente não é enviado
# (só um aviso no log) — nunca derruba o pagamento por causa disso.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=financeiro@sancocore.com.br
SMTP_PASS=
SMTP_FROM=financeiro@sancocore.com.br
